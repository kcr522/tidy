{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tidy 달력",
  "mainBinaryName": "tidy-widget",
  "version": "0.1.0",
  "identifier": "com.kcr522.tidy.widget",
  "build": {
    "frontendDist": "offline"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "category": "Productivity",
    "shortDescription": "Tidy 달력을 바탕화면에 띄워 두는 위젯",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "languages": [
          "Korean"
        ],
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "tidy-widget"
        ]
      }
    }
  }
}
