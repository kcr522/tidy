rules_version = '2';
// Tidy 기기 동기화 보안 규칙
// 로그인한 사람은 자기 자리(users/내 uid/…)만 읽고 쓸 수 있다. 다른 사람 기록은 볼 수 없다.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
